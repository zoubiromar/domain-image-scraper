# Copy this file to .env.local and fill in your own values.

# OpenAI API key (used by Catalog Matcher and Listing QA)
OPENAI_API_KEY=

# SerpAPI key (used by Domain Image Scraper)
SERP_API_KEY=

# Vercel Blob URL hosting the prebuilt SQLite catalog (production matcher only)
# Leave empty for local development if you run `npm run build-db` to generate
# public/database/products.db locally.
DATABASE_BLOB_URL=

# Public Vercel Blob base URL used by the job system to persist long-running
# jobs across devices. Leave empty to fall back to localStorage only.
NEXT_PUBLIC_BLOB_BASE_URL=
